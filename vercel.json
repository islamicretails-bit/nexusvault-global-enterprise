import { Decimal } from '@prisma/client';
import { generateLicenseKey, generateDownloadLink } from './security';

describe('security', () => {
  it('should generate a new license key', async () => {
    const orderId = 'test-order-id';
    const productId = 'test-product-id';

    const licenseKey = await generateLicenseKey(orderId, productId);

    expect(licenseKey.orderId).toBe(orderId);
    expect(licenseKey.productId).toBe(productId);
    expect(licenseKey.licenseKey).toBeInstanceOf(String);
  });

  it('should generate a new download link', async () => {
    const productId = 'test-product-id';

    const downloadLink = await generateDownloadLink(productId);

    expect(downloadLink.productId).toBe(productId);
    expect(downloadLink.downloadLink).toBeInstanceOf(String);
  });
});

