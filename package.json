**tests/dependencies.test.ts**

import { expect } from '@jest/globals';

describe('Dependencies', () => {
  it('should have the correct version of @prisma/client', () => {
    const prismaClientVersion = require('@prisma/client/package.json').version;
    expect(prismaClientVersion).toBe('^4.7.1');
  });

  it('should have the correct version of next', () => {
    const nextVersion = require('next/package.json').version;
    expect(nextVersion).toBe('14.0.0');
  });

  it('should have the correct version of react', () => {
    const reactVersion = require('react/package.json').version;
    expect(reactVersion).toBe('18.2.0');
  });

  it('should have the correct version of tailwindcss', () => {
    const tailwindcssVersion = require('tailwindcss/package.json').version;
    expect(tailwindcssVersion).toBe('^3.2.4');
  });
});


