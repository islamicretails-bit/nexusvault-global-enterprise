import { execSync } from 'child_process';
import { expect } from '@jest/globals';

describe('Scripts', () => {
  it('should run the dev script successfully', () => {
    const output = execSync('npm run dev', { stdio: 'pipe' });
    expect(output.toString()).not.toContain('error');
  });

  it('should run the build script successfully', () => {
    const output = execSync('npm run build', { stdio: 'pipe' });
